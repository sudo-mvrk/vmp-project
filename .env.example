# Copy to .env and fill in. .env is ignored by git.
# docker compose reads .env from this directory; the application needs the same variables in its environment.

# PostgreSQL (service "postgres")
POSTGRE_DB=volunnear
DB_USERNAME=volunnear
DB_PASSWORD=change-me
# Used when the application runs on the host. Inside docker compose the app service overrides the host with "postgres".
DB_URL=jdbc:postgresql://localhost:5432/volunnear

# Redis (service "redis", HTTP sessions)
REDIS_PASSWORD=change-me

# First platform admin, inserted once by migration V7 (Q28). ADMIN_PASSWORD_HASH is a bcrypt hash, never the password.
# Keep the single quotes: the hash contains "$", which docker compose and the shell would otherwise expand.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH='$2a$10$replace.with.a.real.bcrypt.hash.of.your.password'

# Optional. "seed" loads the demo data on start (Q33, docs/DEMO.md); leave empty in production.
SPRING_PROFILES_ACTIVE=
